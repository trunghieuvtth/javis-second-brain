{
  "id": "javis-second-brain",
  "name": "Kho Tri Thức Số & Second Brain AI",
  "version": "1.0.0",
  "category": "productivity",
  "tags": ["second-brain", "rag", "knowledge-management", "nd30-docx", "ai-assistant"],
  "author": "Sở Khoa học và Công nghệ tỉnh Tây Ninh",
  "icon": "fa-brain",
  "color": "#0d9488",
  "description": "Nền tảng quản trị tri thức số đa nguồn (Drive, Thư mục máy, Tệp đính kèm, Web), phân quyền ma trận 3 tầng (Cá nhân, Phòng ban, Toàn xã/cơ quan) và Trợ lý AI tự động soạn thảo 21 loại văn bản hành chính chuẩn Nghị định 30/2020/NĐ-CP và Hướng dẫn 05-HD/VPTW.",
  "entry_point": "app:app",
  "default_port": 8090,
  "autostart": true,
  "health_check": "/api/personal-brain/settings",
  "requirements": [
    "python>=3.10",
    "fastapi>=0.110.0",
    "uvicorn>=0.28.0",
    "pydantic>=2.0.0",
    "requests>=2.28.0",
    "python-multipart>=0.0.9",
    "python-docx>=1.1.0"
  ],
  "scripts": {
    "install_linux": "bash install.sh",
    "install_windows": "install_windows.bat",
    "stop_windows": "stop_service.bat"
  },
  "env": {
    "PORT": "8090",
    "HOST": "0.0.0.0"
  },
  "ui": {
    "display_mode": "standalone",
    "theme_support": ["light", "dark"],
    "mobile_responsive": true
  }
}
